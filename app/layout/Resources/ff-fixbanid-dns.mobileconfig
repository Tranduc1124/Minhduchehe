<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadDisplayName</key>
	<string>MINHDUC DNS</string>
	<key>PayloadDescription</key>
	<string>@BolaMinhDuc</string>
	<key>PayloadOrganization</key>
	<string>MINHDUC</string>
	<key>PayloadIdentifier</key>
	<string>com.minhduc.ff.fixbanid.dns.2026</string>
	<key>PayloadUUID</key>
	<string>9C1D4A77-0B62-4E58-9A31-6F2D8C05B4E1</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadContent</key>
	<array>
		<!--
		  One payload, not two.

		  Settings > General > VPN & Device Management > DNS is a radio group.
		  Each com.apple.dnsSettings.managed payload becomes its own entry there
		  and only one entry can be on at a time, so a profile carrying an Allow
		  payload and a Block payload cannot have both active. The one that is
		  actually wanted is the block, and a block needs nothing else.

		  Apple documents SupplementalMatchDomains as "a list of domain strings
		  used to determine which DNS queries use the DNS server". A server listed
		  there is used for those domains and nothing else, so every domain left
		  out keeps resolving through the system resolver. That is what the Allow
		  payload was doing, only it also forced those eight domains onto
		  Cloudflare DoH instead of the system resolver, which stops the lookup
		  being visible to the local network's resolver.

		  Keeping it costs the block. Turn Allow on and Block goes off, and the
		  account-locking domains start resolving again. The leak it avoids is
		  worth less than the block it disables, so it is gone.

		  192.0.2.1 is TEST-NET-1 from RFC 5737, reserved for documentation and
		  never routable. iOS asks it over DoH, nothing answers, the app never
		  gets an IP. Same observable result as the "action": "reject" this
		  replaces, with no blocking primitive anywhere in the file.

		  Do not add AllowFailover. Apple documents it as defaulting to false,
		  and false is what makes this work: true would let every failed DoH
		  query fall back to the system resolver and every domain here would
		  resolve normally while the profile still reported as installed.

		  A bare domain matches as a suffix, per Apple's own note that both
		  *.example.com and example.com match mydomain.example.com. These are
		  therefore the suffixes from the source config, which already cover the
	  twenty-odd explicit hostnames it also listed.
		-->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadIdentifier</key>
			<string>com.minhduc.ff.fixbanid.dns.block</string>
			<key>PayloadUUID</key>
			<string>3F82B5C1-7A64-4D19-8E02-5C97A1D4B6F3</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>MINHDUC DNS - Block</string>
			<key>PayloadDescription</key>
			<string>Sends the account-locking Free Fire domains to a resolver that does not exist.</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://192.0.2.1/dns-query</string>
				<key>SupplementalMatchDomains</key>
				<array>
					<string>freefiremobile.com</string>
					<string>freefireth.com</string>
					<string>ff.garena.com</string>
					<string>ff.rtc.grtc.garenanow.com</string>
					<string>ff.sdk.grtc.garenanow.com</string>
					<string>ff.dr.grtc.garenanow.com</string>
					<string>cdn.garenanow.com</string>
					<string>dl.garenanow.com</string>
					<string>cdn.gxx.garenanow.com</string>
					<string>dl.hdltw.garenanow.com</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>